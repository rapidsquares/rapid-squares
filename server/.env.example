# Rapid Squares server settings. Copy this file to server/.env and fill it in.
# server/.env is never committed. On Render, set the same names as environment variables.
# `npm run check` tests every connection and explains what to fix.

# ---------- Site ----------
# Where people reach the site (links in emails and downloads). Locally: http://localhost:3000
APP_URL=http://localhost:3000
# PORT=3000

# ---------- Supabase (required): Project Settings › Data API and API Keys ----------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------- RoofQuery: rq_test_sk_… for the sandbox, rq_live_sk_… for real reports ----------
ROOFQUERY_API_KEY=
# Long random text; the webhook in the RoofQuery portal is <APP_URL>/webhooks/roofquery/<this>
ROOFQUERY_WEBHOOK_SECRET=
# What Premium reports measure by default: primary_only · primary_and_garage · all_structures
# ROOFQUERY_SCOPE=primary_and_garage

# ---------- Stripe: sk_test_… while testing, sk_live_… to take real payments ----------
STRIPE_SECRET_KEY=
# From the webhook for <APP_URL>/webhooks/stripe in the Stripe dashboard (whsec_…)
STRIPE_WEBHOOK_SECRET=
# SUBSCRIPTION_MONTHLY_CENTS=10000
# SUBSCRIPTION_YEARLY_CENTS=100000
# TRIAL_DAYS=30

# ---------- Email (Resend): the From address must be on a domain verified in Resend ----------
RESEND_API_KEY=
EMAIL_FROM="Rapid Squares <reports@rapidsquares.com>"
EMAIL_REPLY_TO=
# Gets problems that need a person (low RoofQuery balance, failed refunds) and order alerts
ADMIN_EMAIL=
# ORDER_ALERTS=true

# ---------- Maps ----------
# Azure Maps: the map and aerial photos
AZURE_MAPS_KEY=
# Google Places API (New): address suggestions as you type. Restrict it to your site's address in Google Cloud.
GOOGLE_MAPS_KEY=

# ---------- Orders ----------
# Free Premium reports for each new company
FREE_REPORTS_ON_SIGNUP=0
# Companies that get everything free: comma-separated emails (a team member's or the company's)
FREE_ACCOUNT_EMAILS=
# Only for testing without Stripe: lets orders through without payment. Keep false.
ALLOW_UNPAID_TEST_ORDERS=false
